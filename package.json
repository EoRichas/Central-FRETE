{
  "name": "central-frete",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start-server.mjs",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "test:integration": "node --import tsx --experimental-test-module-mocks --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "postgres": "3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Central Frete"
}
