# Identificação adicional da Central Express nos novos documentos (opcional)
CENTRAL_EXPRESS_DOCUMENT=
CENTRAL_EXPRESS_ADDRESS=
CENTRAL_EXPRESS_CONTACT=

# Copie a URI exata em Supabase > Connect > Session pooler.
# O nome do usuário precisa incluir o identificador do projeto.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA_CODIFICADA@SEU_HOST.pooler.supabase.com:5432/postgres

# Gere um valor aleatório com pelo menos 32 caracteres.
CENTRAL_FRETE_SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES

# Necessárias para anexos e comprovantes. Nunca exponha a service_role no navegador.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=central-frete

# Sem chave Google, CEPs usam BrasilAPI + OSRM. Instância própria opcional:
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=

# Segurança: configure a origem exata na hospedagem (sem caminho).
# Enquanto vazia, usa a origem da URL recebida. Não aceita X-Forwarded-Host do cliente.
CENTRAL_FRETE_PUBLIC_ORIGIN=

# Apenas durante a criação do primeiro administrador; remover depois.
# Gere fora do chat um segredo aleatório de 32 a 256 caracteres.
CENTRAL_FRETE_SETUP_TOKEN=

# Gateway futuro: deixar AMBAS vazias até configurar Cloudflare Access.
# Ao preencher, TODAS as rotas passam a exigir um JWT válido do Access.
CENTRAL_ACCESS_ISSUER=
CENTRAL_ACCESS_AUDIENCE=

# Migrações separadas do usuário de execução (opcional, implantação coordenada).
# Sem configuração, mantém o comportamento anterior de migração na inicialização.
DATABASE_MIGRATION_URL=
CENTRAL_FRETE_MIGRATE_ON_START=true
