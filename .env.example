# Copie a URI exata em Supabase > Connect > Session pooler.
# O nome do usuário precisa incluir o identificador do projeto.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA_CODIFICADA@SEU_HOST.pooler.supabase.com:5432/postgres

# Gere um valor aleatório com pelo menos 32 caracteres.
CENTRAL_FRETE_SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES

# Necessárias para anexos e comprovantes. Nunca exponha a service_role no navegador.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=central-frete

# Licença mensal (ativar somente após configurar/testar o provedor)
BILLING_ENABLED=false
APP_URL=https://central-frete-1l01.onrender.com
BILLING_COMPANY_ID=
BILLING_COMPANY_NAME=
# Setembro/2026 liberado; primeira mensalidade vence em 05/10/2026.
BILLING_FIRST_COMPETENCY=2026-10
BILLING_CHECKOUT_MODE=monthly
MERCADO_PAGO_MODE=test
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_PLAN_ID=
MERCADO_PAGO_SUBSCRIPTION_ID=
BILLING_PAYER_EMAIL=
BILLING_CRON_SECRET=
BILLING_SCHEDULER_ENABLED=false
BILLING_NOTIFY_EMAIL=
BILLING_EMAIL_FROM=
RESEND_API_KEY=
GOOGLE_MAPS_API_KEY=
