# Copie a URI exata em Supabase > Connect > Session pooler.
# O nome do usuário precisa incluir o identificador do projeto.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA_CODIFICADA@SEU_HOST.pooler.supabase.com:5432/postgres

# Gere um valor aleatório com pelo menos 32 caracteres.
CENTRAL_FRETE_SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES

# Token usado somente uma vez para proteger a criação do primeiro administrador.
# Use pelo menos 24 caracteres e mantenha apenas no servidor/Render.
CENTRAL_FRETE_SETUP_TOKEN=SUBSTITUA_POR_UM_TOKEN_DE_CONFIGURACAO_SEGURO

# Necessárias para anexos e comprovantes. Nunca exponha a service_role no navegador.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=central-frete
